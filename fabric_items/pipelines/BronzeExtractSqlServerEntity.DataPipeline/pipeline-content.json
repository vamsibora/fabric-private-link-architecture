{
  "properties": {
    "description": "Extracts ONE SQL Server entity for a Bronze framework run. landing_enabled = true: Copy -> Storage Account JSON <container>/<source_system>/<table>/<table>_<yyyyMMddHHmmss>.json (never overwritten). landing_enabled = false: Copy -> Bronze Lakehouse staging table (table action Overwrite = truncate + load) stamped with _staging_run_id. Audits every step in the central audit SQL Database. Pipelines orchestrate; the BronzeFramework notebook processes. The SOURCE connection is parameterised: source_connection_id (a Fabric connection GUID) comes from control.source_connection.fabric_connection_id for the entity's source system and environment, so one pipeline serves any number of SQL Server instances. The run fails fast if it is not configured. Landing and audit connection ids 00000000-...-a00N are placeholders -- see fabric_items/README.md.",
    "activities": [
      {
        "name": "AuditStartEntityRun",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 2,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "storedProcedureName": "[audit].[usp_start_entity_run]",
          "storedProcedureParameters": {
            "entity_run_id": {
              "value": {
                "value": "@pipeline().parameters.entity_run_id",
                "type": "Expression"
              },
              "type": "String"
            },
            "run_id": {
              "value": {
                "value": "@pipeline().parameters.run_id",
                "type": "Expression"
              },
              "type": "String"
            },
            "entity_id": {
              "value": {
                "value": "@pipeline().parameters.entity_id",
                "type": "Expression"
              },
              "type": "Int64"
            },
            "source_system": {
              "value": {
                "value": "@pipeline().parameters.source_system",
                "type": "Expression"
              },
              "type": "String"
            },
            "source_schema": {
              "value": {
                "value": "@pipeline().parameters.source_schema",
                "type": "Expression"
              },
              "type": "String"
            },
            "source_table": {
              "value": {
                "value": "@pipeline().parameters.source_table",
                "type": "Expression"
              },
              "type": "String"
            },
            "target_schema": {
              "value": {
                "value": "@pipeline().parameters.target_schema",
                "type": "Expression"
              },
              "type": "String"
            },
            "target_table": {
              "value": {
                "value": "@pipeline().parameters.target_table",
                "type": "Expression"
              },
              "type": "String"
            },
            "load_type": {
              "value": {
                "value": "@pipeline().parameters.load_type",
                "type": "Expression"
              },
              "type": "String"
            },
            "landing_enabled": {
              "value": {
                "value": "@pipeline().parameters.landing_enabled",
                "type": "Expression"
              },
              "type": "Boolean"
            },
            "watermark_before": {
              "value": {
                "value": "@if(empty(pipeline().parameters.watermark_before), null, pipeline().parameters.watermark_before)",
                "type": "Expression"
              },
              "type": "String"
            },
            "pipeline_run_id": {
              "value": {
                "value": "@pipeline().RunId",
                "type": "Expression"
              },
              "type": "String"
            },
            "status": {
              "value": "EXTRACTING",
              "type": "String"
            }
          }
        },
        "externalReferences": {
          "connection": "00000000-0000-0000-0000-00000000a003"
        }
      },
      {
        "name": "IfSourceConnectionMissing",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "AuditStartEntityRun",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@empty(pipeline().parameters.source_connection_id)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "AuditMissingConnectionError",
              "type": "SqlServerStoredProcedure",
              "dependsOn": [],
              "policy": {
                "timeout": "0.00:10:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "storedProcedureName": "[audit].[usp_log_error]",
                "storedProcedureParameters": {
                  "run_id": {
                    "value": {
                      "value": "@pipeline().parameters.run_id",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "entity_run_id": {
                    "value": {
                      "value": "@pipeline().parameters.entity_run_id",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "error_stage": {
                    "value": "EXTRACT",
                    "type": "String"
                  },
                  "error_code": {
                    "value": "SOURCE_CONNECTION_NOT_CONFIGURED",
                    "type": "String"
                  },
                  "error_message": {
                    "value": {
                      "value": "@concat('control.source_connection.fabric_connection_id is not set for ', pipeline().parameters.source_system, ' in ', pipeline().parameters.environment, ' (docs/runbooks/02_metadata_maintenance.md, Environment connection values)')",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "source_system": {
                    "value": {
                      "value": "@pipeline().parameters.source_system",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "source_table": {
                    "value": {
                      "value": "@pipeline().parameters.source_table",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "is_retryable": {
                    "value": false,
                    "type": "Boolean"
                  }
                }
              },
              "externalReferences": {
                "connection": "00000000-0000-0000-0000-00000000a003"
              }
            },
            {
              "name": "AuditMissingConnectionFailed",
              "type": "SqlServerStoredProcedure",
              "dependsOn": [
                {
                  "activity": "AuditMissingConnectionError",
                  "dependencyConditions": [
                    "Completed"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.00:10:00",
                "retry": 2,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "storedProcedureName": "[audit].[usp_update_entity_run]",
                "storedProcedureParameters": {
                  "entity_run_id": {
                    "value": {
                      "value": "@pipeline().parameters.entity_run_id",
                      "type": "Expression"
                    },
                    "type": "String"
                  },
                  "status": {
                    "value": "FAILED",
                    "type": "String"
                  },
                  "error_message": {
                    "value": "Source connection not configured; see audit.error",
                    "type": "String"
                  }
                }
              },
              "externalReferences": {
                "connection": "00000000-0000-0000-0000-00000000a003"
              }
            },
            {
              "name": "FailSourceConnectionMissing",
              "type": "Fail",
              "dependsOn": [
                {
                  "activity": "AuditMissingConnectionFailed",
                  "dependencyConditions": [
                    "Completed"
                  ]
                }
              ],
              "typeProperties": {
                "message": {
                  "value": "@concat('No source connection configured for ', pipeline().parameters.source_system, ' in ', pipeline().parameters.environment)",
                  "type": "Expression"
                },
                "errorCode": "SOURCE_CONNECTION_NOT_CONFIGURED"
              }
            }
          ],
          "ifFalseActivities": []
        }
      },
      {
        "name": "IfLandingEnabled",
        "type": "IfCondition",
        "dependsOn": [
          {
            "activity": "IfSourceConnectionMissing",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "expression": {
            "value": "@bool(pipeline().parameters.landing_enabled)",
            "type": "Expression"
          },
          "ifTrueActivities": [
            {
              "name": "CheckLandingFileExists",
              "type": "GetMetadata",
              "dependsOn": [],
              "policy": {
                "timeout": "0.00:10:00",
                "retry": 1,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "fieldList": [
                  "exists"
                ],
                "datasetSettings": {
                  "annotations": [],
                  "type": "Json",
                  "typeProperties": {
                    "location": {
                      "type": "AzureBlobFSLocation",
                      "fileName": {
                        "value": "@concat(pipeline().parameters.source_table,'_',pipeline().parameters.run_timestamp,'.json')",
                        "type": "Expression"
                      },
                      "folderPath": {
                        "value": "@pipeline().parameters.landing_folder",
                        "type": "Expression"
                      },
                      "fileSystem": {
                        "value": "@pipeline().parameters.landing_container",
                        "type": "Expression"
                      }
                    }
                  },
                  "schema": {},
                  "externalReferences": {
                    "connection": "00000000-0000-0000-0000-00000000a002"
                  }
                },
                "storeSettings": {
                  "type": "AzureBlobFSReadSettings",
                  "recursive": false,
                  "enablePartitionDiscovery": false
                },
                "formatSettings": {
                  "type": "JsonReadSettings"
                }
              }
            },
            {
              "name": "IfLandingFileExists",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "CheckLandingFileExists",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "expression": {
                  "value": "@activity('CheckLandingFileExists').output.exists",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "FailLandingFileExists",
                    "type": "Fail",
                    "dependsOn": [],
                    "typeProperties": {
                      "message": {
                        "value": "@concat('Landing file already exists, refusing to overwrite: ', concat(pipeline().parameters.landing_folder,'/',pipeline().parameters.source_table,'_',pipeline().parameters.run_timestamp,'.json'))",
                        "type": "Expression"
                      },
                      "errorCode": "LANDING_FILE_EXISTS"
                    }
                  }
                ],
                "ifFalseActivities": []
              }
            },
            {
              "name": "CopyToLanding",
              "type": "Copy",
              "dependsOn": [
                {
                  "activity": "IfLandingFileExists",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 60,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "SqlServerSource",
                  "sqlReaderQuery": {
                    "value": "@pipeline().parameters.source_query",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None",
                  "datasetSettings": {
                    "annotations": [],
                    "type": "SqlServerTable",
                    "schema": [],
                    "typeProperties": {
                      "database": {
                        "value": "@pipeline().parameters.source_database",
                        "type": "Expression"
                      }
                    },
                    "externalReferences": {
                      "connection": {
                        "value": "@pipeline().parameters.source_connection_id",
                        "type": "Expression"
                      }
                    }
                  }
                },
                "sink": {
                  "type": "JsonSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings"
                  },
                  "formatSettings": {
                    "type": "JsonWriteSettings",
                    "filePattern": "setOfObjects"
                  },
                  "datasetSettings": {
                    "annotations": [],
                    "type": "Json",
                    "typeProperties": {
                      "location": {
                        "type": "AzureBlobFSLocation",
                        "fileName": {
                          "value": "@concat(pipeline().parameters.source_table,'_',pipeline().parameters.run_timestamp,'.json')",
                          "type": "Expression"
                        },
                        "folderPath": {
                          "value": "@pipeline().parameters.landing_folder",
                          "type": "Expression"
                        },
                        "fileSystem": {
                          "value": "@pipeline().parameters.landing_container",
                          "type": "Expression"
                        }
                      }
                    },
                    "schema": {},
                    "externalReferences": {
                      "connection": "00000000-0000-0000-0000-00000000a002"
                    }
                  }
                },
                "enableStaging": false,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": false,
                    "treatBooleanAsNumber": false
                  }
                }
              }
            },
